# Optional. The solver runs entirely without this — only the three AI steps
# need it (job description -> skills, solver trace -> English, chat -> constraint
# patch). A key pasted into the header bar at runtime takes precedence over this
# one and is stored per-browser in an httpOnly cookie, never sent to the client.
#
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Sign in. The demo door works with none of these set; Google needs all three.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma separated emails allowed to open /admin
ADMIN_EMAILS=

# The judges' shared inbox: the owner's real Gmail, scanned read only through
# an app password, so a judge can see the tracker work on real mail without
# connecting their own. Leave the password empty to disable the button.
JUDGE_INBOX_EMAIL=
JUDGE_INBOX_APP_PASSWORD=

# Postgres. All app tables are prefixed carpa_; nothing else in the database is touched.
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Development only. Opens the demo sign-in door (any typed email becomes an
# account). Leave UNSET in production: with it set, a visitor could sign in as
# any non-admin address. Admin addresses are refused by the door regardless.
# NEXT_PUBLIC_ALLOW_DEMO=1

# Whole-deployment ceiling on model spend per rolling day, in dollars.
# Defaults to 20. The open, unauthenticated reading routes refuse politely
# above it, so a loop cannot empty the balance during judging.
DAILY_SPEND_CAP_USD=20
